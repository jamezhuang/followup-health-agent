PROVIDER_MODE=demo
CORS_ORIGINS=http://127.0.0.1:3002,http://localhost:3002
COOKIE_SECURE=false
# Live mode: configure your own provider credentials locally. Never commit .env.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
SILICONFLOW_API_KEY=
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIMENSIONS=1024
API_TIMEOUT_SECONDS=30
RAG_RERANK_ENABLED=true
# Adapted rewrite/split, evidence routing and bounded answer review (live mode).
RAG_PROMPT_PIPELINE_ENABLED=true
# Disease/service hospital comparisons allocate pages by coverage target, capped here.
HOSPITAL_SERVICE_PAGE_LIMIT=16
# Conservative pre-call input estimate; actual provider token usage is logged separately.
CONTEXT_INPUT_BUDGET=48000

# Public web search: missing/failed/empty primary automatically falls back to configured services.
EXTERNAL_SEARCH_ENABLED=false
WEB_SEARCH_PROVIDER=baidu
BAIDU_SEARCH_API_KEY=
BOCHA_API_KEY=
TAVILY_API_KEY=
TENCENT_SEARCH_ENABLED=false
# Optional self-hosted SearXNG (JSON format must be enabled).
SEARXNG_URL=
# Set true only if its configured upstream engines satisfy domestic-only deployment.
SEARXNG_DOMESTIC_ONLY=false
WEB_DOMESTIC_ONLY=true
WEB_PUBLIC_READ_ENABLED=true
# Optional isolated Crawl4AI environment, used only when direct page reading fails.
CRAWL4AI_ENABLED=false
CRAWL4AI_PYTHON=
CRAWL4AI_BROWSER=msedge
WEB_BROWSER_MAX_READS=2

# Optional Tencent recognition. Keep disabled until credentials/services are ready.
RECOGNITION_PROVIDER=disabled
OCR_ENABLED=false
ASR_ENABLED=false
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_REGION=ap-guangzhou
TENCENT_ASR_ENGINE=16k_zh
