# Only application code, dependency manifests and the public seed are allowed.
**
!Dockerfile
!.dockerignore
!requirements*.txt
!app/
!app/**
!scripts/
!scripts/**
!data/
data/**
!data/knowledge.json

# Exclude runtime data even if stored below app/ or scripts/.
**/.git
**/.git/**
**/.git-backup
**/.git-backup/**
**/.env
**/.env.*
**/.venv
**/.venv/**
**/.venv-*
**/node_modules
**/node_modules/**
**/__pycache__
**/__pycache__/**
**/*.pyc
**/*.pyo
**/.cache
**/.cache/**
**/.pytest_cache
**/.pytest_cache/**
**/uploads
**/uploads/**
**/user_uploads
**/user_uploads/**
**/private_data
**/private_data/**
**/user_data
**/user_data/**
**/health_records
**/health_records/**
**/backups
**/backups/**
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite-*
**/*.sqlite3
**/*.sqlite3-*
**/*.log
**/*.pem
**/*.key
**/credentials*.json
**/secrets*.json
**/test_*.py
